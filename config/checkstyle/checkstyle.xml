<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- KADR linter (Lab 8, task 10). The project is Java, so Checkstyle replaces ktlint/detekt.
     Rules target real defects and release hygiene rather than formatting taste. -->
<module name="Checker">
    <property name="severity" value="error"/>
    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile"><property name="severity" value="warning"/></module>
    <module name="TreeWalker">
        <module name="EmptyCatchBlock"/>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="CovariantEquals"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="IllegalInstantiation"><property name="classes" value="java.lang.Boolean"/></module>
        <!-- Release hygiene: no System.out / printStackTrace in shipped code -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.(out|err)\.print|\.printStackTrace\(\)"/>
            <property name="message" value="Use android.util.Log (stripped by R8) instead of console output"/>
        </module>
        <!-- No hard-coded secrets -->
        <module name="RegexpSinglelineJava">
            <property name="format" value="(?i)(api[_-]?key|secret|password)\s*=\s*&quot;[A-Za-z0-9+/_\-]{12,}&quot;"/>
            <property name="message" value="Possible hard-coded secret"/>
        </module>
    </module>
</module>
