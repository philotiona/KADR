# KADR — variables for CI / local release builds (Lab 8, task 3).
# Copy to .env (git-ignored) or set as GitHub Actions Secrets. Never commit real values.

# Release signing (task 5)
KADR_KEYSTORE_PATH=/absolute/path/to/kadr-upload.jks
KADR_KEYSTORE_PASSWORD=
KADR_KEY_ALIAS=kadr-upload
KADR_KEY_PASSWORD=
# CI only: the .jks file encoded with `base64 -w0 kadr-upload.jks`
KADR_KEYSTORE_BASE64=

# Optional: Google Play publishing (task 11) — service account JSON
PLAY_SERVICE_ACCOUNT_JSON=

# Optional: override the staging API in local.properties instead
# kadr.stagingApiUrl=https://staging.example.com/api/v1/
